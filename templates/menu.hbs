{{!-- Velvet Move — quick menu --}}
<div class="vmove-menu">

  <section class="vmove-section">
    <h3 class="vmove-heading">
      <i class="fa-solid fa-person-running"></i>
      <span>{{localize "VELVETMOVE.menu.motion"}}</span>
      <span class="vmove-badge" data-tooltip="{{localize 'VELVETMOVE.menu.rendererHint'}}">{{renderer.badge}}</span>
    </h3>

    <div class="vmove-field">
      <label>{{localize "VELVETMOVE.settings.renderer.name"}}</label>
      <select data-setting="renderer">
        {{#each renderer.options as |option|}}
        <option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{localize option.label}}</option>
        {{/each}}
      </select>
    </div>

    {{#if renderer.mismatch}}
    <p class="vmove-hint vmove-warn">
      <i class="fa-solid fa-triangle-exclamation"></i>
      {{localize "VELVETMOVE.settings.renderer.mismatch"}} <strong>{{renderer.detectedLabel}}</strong>
    </p>
    {{/if}}

    <label class="vmove-toggle">
      <input type="checkbox" data-setting="hopEnabled" {{checked motion.hopEnabled}}>
      <span>{{localize "VELVETMOVE.settings.hopEnabled.name"}}</span>
    </label>

    <div class="vmove-field">
      <label>{{localize "VELVETMOVE.settings.hopHeight.name"}}</label>
      <div class="vmove-range">
        <input type="range" data-setting="hopHeight" min="0" max="0.6" step="0.01" value="{{motion.hopHeight}}">
        <span class="vmove-value">{{motion.hopPercent}}%</span>
      </div>
    </div>

    {{#if isGM}}
    <div class="vmove-field">
      <label>{{localize "VELVETMOVE.settings.stepLength.name"}}</label>
      <div class="vmove-range">
        <input type="range" data-setting="stepLength" min="0.25" max="3" step="0.05" value="{{motion.stepLength}}">
        <span class="vmove-value vmove-value-plain">{{numberFormat motion.stepLength decimals=2}}</span>
      </div>
    </div>

    <label class="vmove-toggle">
      <input type="checkbox" data-setting="ignoreElevated" {{checked motion.ignoreElevated}}>
      <span>{{localize "VELVETMOVE.settings.ignoreElevated.name"}}</span>
    </label>
    {{/if}}

    <hr>

    {{#if isGM}}
    <label class="vmove-toggle">
      <input type="checkbox" data-setting="talespireEcosystem" {{checked motion.talespireEcosystem}}>
      <span>{{localize "VELVETMOVE.settings.talespireEcosystem.name"}}</span>
      <i class="fa-solid fa-circle-info" data-tooltip="{{localize 'VELVETMOVE.settings.talespireEcosystem.hint'}}"></i>
    </label>
    {{/if}}

    <label class="vmove-toggle">
      <input type="checkbox" data-setting="soundEnabled" {{checked motion.soundEnabled}}>
      <span>{{localize "VELVETMOVE.settings.soundEnabled.name"}}</span>
    </label>

    <div class="vmove-field">
      <label>{{localize "VELVETMOVE.settings.masterVolume.name"}}</label>
      <div class="vmove-range">
        <input type="range" data-setting="masterVolume" min="0" max="1" step="0.05" value="{{motion.masterVolume}}">
        <span class="vmove-value">{{motion.volumePercent}}%</span>
      </div>
    </div>

    <div class="vmove-field">
      <label>{{localize "VELVETMOVE.settings.pitchVariation.name"}}</label>
      <div class="vmove-range">
        <input type="range" data-setting="pitchVariation" min="0" max="0.4" step="0.01" value="{{motion.pitchVariation}}">
        <span class="vmove-value">{{motion.pitchPercent}}%</span>
      </div>
    </div>

    <div class="vmove-field">
      <label>{{localize "VELVETMOVE.settings.audience.name"}}</label>
      <select data-setting="audience">
        {{#each motion.audienceOptions as |option|}}
        <option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{localize option.label}}</option>
        {{/each}}
      </select>
    </div>
  </section>

  <section class="vmove-section">
    <h3 class="vmove-heading">
      <i class="fa-solid fa-layer-group"></i>
      <span>{{localize "VELVETMOVE.menu.surfaces"}}</span>
      {{#if isGM}}
      <button type="button" class="vmove-icon-button" data-action="addSurface"
              data-tooltip="{{localize 'VELVETMOVE.menu.newSurface'}}">
        <i class="fa-solid fa-plus"></i>
      </button>
      {{/if}}
    </h3>

    <p class="vmove-hint">
      {{#if isGM}}{{localize "VELVETMOVE.menu.surfacesHint"}}
      {{else}}{{localize "VELVETMOVE.menu.surfacesHintPlayer"}}{{/if}}
    </p>

    <ol class="vmove-surfaces">
      {{#each surfaces as |surface|}}
      <li class="vmove-surface {{#if surface.active}}is-active{{/if}}" data-surface-id="{{surface.id}}">

        <div class="vmove-surface-row">
          <button type="button" class="vmove-surface-pick" data-action="activate" data-surface-id="{{surface.id}}"
                  data-tooltip="{{localize 'VELVETMOVE.menu.useForScene'}}">
            <i class="{{surface.icon}}"></i>
            <span class="vmove-surface-name">{{surface.name}}</span>
          </button>

          {{#if surface.isDefault}}
          <span class="vmove-tag" data-tooltip="{{localize 'VELVETMOVE.menu.defaultTag'}}">
            <i class="fa-solid fa-star"></i>
          </span>
          {{/if}}
          <span class="vmove-count" data-tooltip="{{localize 'VELVETMOVE.menu.soundCount'}}">{{surface.files.length}}</span>

          <button type="button" class="vmove-icon-button" data-action="preview" data-surface-id="{{surface.id}}"
                  data-tooltip="{{localize 'VELVETMOVE.menu.preview'}}">
            <i class="fa-solid fa-volume-high"></i>
          </button>

          {{#if @root.isGM}}
          <button type="button" class="vmove-icon-button" data-action="toggleExpand" data-surface-id="{{surface.id}}"
                  data-tooltip="{{localize 'VELVETMOVE.menu.edit'}}">
            <i class="fa-solid {{#if surface.expanded}}fa-chevron-up{{else}}fa-sliders{{/if}}"></i>
          </button>
          {{/if}}
        </div>

        {{#if surface.expanded}}
        <div class="vmove-editor">

          <div class="vmove-editor-grid">
            <label>{{localize "VELVETMOVE.menu.label"}}</label>
            <input type="text" value="{{surface.name}}"
                   data-surface-field="label" data-surface-id="{{surface.id}}">

            <label>{{localize "VELVETMOVE.menu.icon"}}</label>
            <input type="text" value="{{surface.icon}}" placeholder="fa-solid fa-mountain"
                   data-surface-field="icon" data-surface-id="{{surface.id}}">

            <label>{{localize "VELVETMOVE.menu.volume"}}</label>
            <div class="vmove-range">
              <input type="range" min="0" max="1.5" step="0.05" value="{{surface.volume}}"
                     data-surface-field="volume" data-surface-id="{{surface.id}}">
              <span class="vmove-value">{{surface.volumePercent}}%</span>
            </div>
          </div>

          <div class="vmove-sounds-head">
            <span>{{localize "VELVETMOVE.menu.sounds"}} ({{surface.files.length}})</span>
            {{#if surface.files.length}}
            <button type="button" class="vmove-icon-button vmove-danger" data-action="clearSounds"
                    data-surface-id="{{surface.id}}" data-tooltip="{{localize 'VELVETMOVE.menu.clearSounds'}}">
              <i class="fa-solid fa-trash-can"></i>
            </button>
            {{/if}}
          </div>

          <ol class="vmove-files">
            {{#each surface.files as |file|}}
            <li class="vmove-file">
              <button type="button" class="vmove-icon-button" data-action="playSound" data-path="{{file.path}}"
                      data-tooltip="{{localize 'VELVETMOVE.menu.play'}}">
                <i class="fa-solid fa-play"></i>
              </button>
              <span class="vmove-file-name" data-tooltip="{{file.path}}">{{file.name}}</span>
              <button type="button" class="vmove-icon-button vmove-danger" data-action="removeSound"
                      data-surface-id="{{surface.id}}" data-index="{{file.index}}"
                      data-tooltip="{{localize 'VELVETMOVE.menu.remove'}}">
                <i class="fa-solid fa-xmark"></i>
              </button>
            </li>
            {{else}}
            <li class="vmove-empty">{{localize "VELVETMOVE.menu.noSounds"}}</li>
            {{/each}}
          </ol>

          <div class="vmove-buttons">
            <button type="button" data-action="addFile" data-surface-id="{{surface.id}}">
              <i class="fa-solid fa-file-audio"></i> {{localize "VELVETMOVE.menu.addFile"}}
            </button>
            <button type="button" data-action="addFolder" data-surface-id="{{surface.id}}">
              <i class="fa-solid fa-folder-open"></i> {{localize "VELVETMOVE.menu.addFolder"}}
            </button>
            <button type="button" data-action="addPath" data-surface-id="{{surface.id}}"
                    data-tooltip="{{localize 'VELVETMOVE.menu.addPathHint'}}">
              <i class="fa-solid fa-keyboard"></i> {{localize "VELVETMOVE.menu.addPath"}}
            </button>
          </div>

          <div class="vmove-buttons">
            <button type="button" data-action="setDefault" data-surface-id="{{surface.id}}"
                    data-tooltip="{{localize 'VELVETMOVE.menu.setDefaultHint'}}">
              <i class="fa-solid fa-star"></i> {{localize "VELVETMOVE.menu.setDefault"}}
            </button>
            <button type="button" data-action="assignTokens" data-surface-id="{{surface.id}}"
                    data-tooltip="{{localize 'VELVETMOVE.menu.assignHint'}}">
              <i class="fa-solid fa-user-check"></i> {{localize "VELVETMOVE.menu.assign"}} ({{@root.selectedCount}})
            </button>
            <button type="button" class="vmove-danger" data-action="deleteSurface" data-surface-id="{{surface.id}}">
              <i class="fa-solid fa-trash"></i> {{localize "VELVETMOVE.menu.delete"}}
            </button>
          </div>
        </div>
        {{/if}}
      </li>
      {{/each}}
    </ol>

    {{#if isGM}}
    <div class="vmove-buttons vmove-buttons-wide">
      <button type="button" data-action="clearTokens">
        <i class="fa-solid fa-eraser"></i> {{localize "VELVETMOVE.menu.clearTokens"}}
      </button>
    </div>
    {{/if}}
  </section>

  {{#if isGM}}
  <section class="vmove-section">
    <h3 class="vmove-heading">
      <i class="fa-solid fa-floppy-disk"></i>
      <span>{{localize "VELVETMOVE.menu.setup"}}</span>
    </h3>

    <p class="vmove-hint">{{localize "VELVETMOVE.menu.setupHint"}}</p>

    <div class="vmove-field">
      <label>{{localize "VELVETMOVE.menu.presets"}}</label>
      <select data-preset-select>
        {{#each presets as |preset|}}
        <option value="{{preset.path}}">{{preset.name}}</option>
        {{else}}
        <option value="">{{localize "VELVETMOVE.menu.noPresets"}}</option>
        {{/each}}
      </select>
      <button type="button" class="vmove-icon-button" data-action="refreshPresets"
              data-tooltip="{{localize 'VELVETMOVE.menu.refreshPresets'}}">
        <i class="fa-solid fa-rotate"></i>
      </button>
    </div>

    <div class="vmove-buttons vmove-buttons-wide">
      <button type="button" data-action="loadPreset" {{#unless presets.length}}disabled{{/unless}}>
        <i class="fa-solid fa-folder-open"></i> {{localize "VELVETMOVE.menu.loadPreset"}}
      </button>
      <button type="button" data-action="savePreset" {{#unless canUpload}}disabled{{/unless}}
              data-tooltip="{{localize 'VELVETMOVE.menu.savePresetTooltip'}}">
        <i class="fa-solid fa-floppy-disk"></i> {{localize "VELVETMOVE.menu.savePreset"}}
      </button>
    </div>

    <hr>

    <div class="vmove-buttons vmove-buttons-wide">
      <button type="button" data-action="exportFile">
        <i class="fa-solid fa-download"></i> {{localize "VELVETMOVE.menu.exportFile"}}
      </button>
      <button type="button" data-action="importFile">
        <i class="fa-solid fa-upload"></i> {{localize "VELVETMOVE.menu.importFile"}}
      </button>
      <button type="button" data-action="copyJson">
        <i class="fa-solid fa-copy"></i> {{localize "VELVETMOVE.menu.copyJson"}}
      </button>
      <button type="button" data-action="pasteJson">
        <i class="fa-solid fa-paste"></i> {{localize "VELVETMOVE.menu.pasteJson"}}
      </button>
    </div>

    <p class="vmove-hint vmove-folder">
      <i class="fa-solid fa-circle-info"></i>
      {{localize "VELVETMOVE.menu.presetFolderNote"}} <code>{{presetFolder}}/</code>
    </p>
  </section>
  {{/if}}
</div>
