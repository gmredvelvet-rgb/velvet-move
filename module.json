{
  "id": "velvet-move",
  "title": "Velvet Move — Hop & Footsteps",
  "description": "Tokens hop as they walk and footsteps sound underneath them, with a per-surface sound library (stone, wood, grass…) picked from a quick menu in the left toolbar. Works in top-down 2D, in Isometric Perspective scenes and in theripper93 3D Canvas.",
  "version": "1.2.4",
  "compatibility": {
    "minimum": "13",
    "verified": "14",
    "maximum": "14"
  },
  "authors": [
    {
      "name": "Velvet Studio"
    }
  ],
  "esmodules": [
    "scripts/main.js"
  ],
  "styles": [
    "styles/velvet-move.css",
    "styles/velvet-move-license.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    },
    {
      "lang": "es",
      "name": "Español",
      "path": "lang/es.json"
    }
  ],
  "relationships": {
    "optional": [
      {
        "id": "talespire-canvas-bridge",
        "type": "module"
      },
      {
        "id": "isometric-perspective",
        "type": "module"
      },
      {
        "id": "levels-3d-preview",
        "type": "module"
      }
    ],
    "requires": [
      {
        "id": "velvet-license-hub",
        "type": "module",
        "manifest": "https://github.com/gmredvelvet-rgb/velvet-license-hub/releases/latest/download/module.json",
        "compatibility": {
          "minimum": "2.0.0"
        }
      }
    ]
  },
  "url": "https://github.com/gmredvelvet-rgb/velvet-move",
  "manifest": "https://github.com/gmredvelvet-rgb/velvet-move/releases/latest/download/module.json",
  "download": "https://github.com/gmredvelvet-rgb/velvet-move/releases/latest/download/module.zip",
  "socket": false
}
